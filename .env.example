# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=-1001234567890

# --- Time ---
TIMEZONE=Asia/Phnom_Penh

# --- Self-check heartbeat (sent to Telegram) ---
HEALTHCHECK_TIMES=09:00,11:00,14:00,16:00,21:00
# mon,tue,wed,thu,fri,sat,sun (default skips Saturday)
HEALTHCHECK_DAYS=mon,tue,wed,thu,fri,sun

# --- Certificate confirmation after a "success" hook ---
# A freshly renewed 90-day cert shows ~89 days left; 85 leaves some slack.
CERT_MIN_VALID_DAYS=85
# CT can lag a few minutes after a renewal; with worker mode use e.g. 5 x 60
CERT_CHECK_RETRIES=3
CERT_CHECK_RETRY_DELAY=20
CERT_PORT=443

# --- Which check to run on a "success" hook ---
# local  = connect from this container (use CERT_CONNECT_HOST below)
# worker = ask the Cloudflare Worker (outside view, bypasses the edge firewall)
# both   = run both; confirmed only if both pass
CERT_CHECK_MODE=worker

# Cloudflare Worker (used when CERT_CHECK_MODE is worker or both)
CERT_WORKER_URL=https://your-worker.your-subdomain.workers.dev
# only if you set CHECK_TOKEN on the Worker
CERT_WORKER_TOKEN=
CERT_WORKER_TIMEOUT=30

# Local check (used when CERT_CHECK_MODE is
